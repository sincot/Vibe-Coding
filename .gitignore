# ===== 构建产物 =====
/build/
# 可选覆盖率构建目录（tests/coverage/run_coverage.sh）
/build-cov/
/cmake-build-*/
CMakeCache.txt
CMakeFiles/
Makefile
cmake_install.cmake
*.o
*.obj
*.a
*.so
*.so.*
*.exe
*.out
oj_server
ojd

# ===== 运行数据库及 SQLite 辅助文件（WAL/SHM） =====
data/oj.db
data/oj.db-wal
data/oj.db-shm
# 单实例互斥锁文件（M3.7，随数据库生成）
data/*.lock
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm

# ===== 日志 =====
*.log
logs/

# ===== 备份 =====
# 忽略 backup/ 下所有备份内容与临时/锁文件（含隐藏文件），仅保留目录占位文件。
backup/*
!backup/.gitkeep
*.dump

# ===== 临时判题文件 =====
tmp/
*.tmp
*.core

# ===== 前端真实浏览器验证产物（playwright-cli） =====
.playwright-cli/
tests/frontend/browser/artifacts/

# ===== 可选覆盖率本地工具链（tests/coverage/install_tools_local.sh） =====
tests/coverage/.tools/

# ===== 敏感配置 =====
.env
.env.*
*.secret
*.key
config.local.*

# ===== 保留目录占位文件 .gitkeep =====
#（上面的规则不会影响 .gitkeep）
